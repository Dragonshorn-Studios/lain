{
  "name": "@lain/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@lain/shared": "workspace:*",
    "acme-client": "^5.4.0",
    "dns-packet": "^5.6.1",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.0",
    "http-proxy": "^1.18.1",
    "sql.js": "^1.13.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/dns-packet": "^5.6.5",
    "@types/http-proxy": "^1.17.16",
    "@types/sql.js": "^1.4.9",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
